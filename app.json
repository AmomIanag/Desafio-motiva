{
  "expo": {
    "name": "Motiva Challenge",
    "slug": "motiva-prototipo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.amomianag.motivachallenge",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#5D20F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5D20F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "32acc14f-8cb4-44b1-9ebc-976d03eee1cf"
      }
    },
    "owner": "amomianag"
  }
}
